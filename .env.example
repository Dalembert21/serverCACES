# Entorno
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1

# Base de Datos (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/caces_db?schema=public"

# Seguridad y Autenticación
JWT_SECRET=super_secreto_para_desarrollo_caces_2026_seguro_minimo_32_caracteres
JWT_EXPIRES_IN=1d
JWT_REFRESH_SECRET=super_secreto_refresh_para_desarrollo_caces_2026_seguro_minimo_32_caracteres
JWT_REFRESH_EXPIRES_IN=7d

# CORS
CORS_ORIGIN=http://localhost:4200

# Rate Limiting
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# Límites de Prueba Gratuita (Configurables)
TRIAL_MAX_PREGUNTAS=30
TRIAL_MAX_SIMULADORES=1
