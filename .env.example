# Entorno
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1

# Base de Datos (PostgreSQL estándar - compatible con Supabase, VPS, RDS, Docker)
# 1. Desarrollo local (Docker / PostgreSQL local):
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/caces_db?schema=public"
DATABASE_SSL=false

# 2. Supabase (Alojamiento en la Nube):
# Se recomienda usar Connection Pooling (Session mode en puerto 5432 o Transaction en 6543) para soporte IPv4:
# DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres?sslmode=require"
# DATABASE_SSL=true

# Supabase API (Opcional - solo si se utiliza Supabase Storage / Auth en el futuro):
# SUPABASE_URL="https://[project-ref].supabase.co"
# SUPABASE_ANON_KEY="eyJhbGci..."
# SUPABASE_SERVICE_ROLE_KEY="eyJhbGci..."

# 3. VPS / Servidor propio en producción (ej. Ubuntu + PostgreSQL con SSL):
# DATABASE_URL="postgresql://usuario_caces:password_seguro@vps.aturitmo.ec:5432/caces_db?sslmode=require"
# DATABASE_SSL=true

# Seguridad y Autenticación
JWT_SECRET=super_secreto_para_desarrollo_caces_2026_seguro_minimo_32_caracteres
JWT_EXPIRES_IN=1d
JWT_EXPIRATION=7d
JWT_REFRESH_SECRET=super_secreto_refresh_para_desarrollo_caces_2026_seguro_minimo_32_caracteres
JWT_REFRESH_EXPIRES_IN=7d

# Google OAuth (Google Identity Services)
GOOGLE_CLIENT_ID=tu_cliente_id.apps.googleusercontent.com

# CORS
CORS_ORIGIN=http://localhost:4200

# Rate Limiting
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# Límites de Prueba Gratuita (Configurables)
TRIAL_MAX_PREGUNTAS=30
TRIAL_MAX_SIMULADORES=1

