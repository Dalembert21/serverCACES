# Entorno
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1

# Base de Datos (PostgreSQL estándar - compatible con Supabase, VPS, RDS, Docker)
# 1. Desarrollo local (Docker / PostgreSQL local):
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/caces_db?schema=public"
DATABASE_SSL=false

# 2. Supabase (Alojamiento inicial):
# Direct connection (puerto 5432) o Transaction pooler (puerto 6543):
# DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?sslmode=require"
# DATABASE_SSL=true

# 3. VPS / Servidor propio en producción (ej. Ubuntu + PostgreSQL con SSL):
# DATABASE_URL="postgresql://usuario_caces:password_seguro@vps.aturitmo.ec:5432/caces_db?sslmode=require"
# DATABASE_SSL=true

# Seguridad y Autenticación
JWT_SECRET=super_secreto_para_desarrollo_caces_2026_seguro_minimo_32_caracteres
JWT_EXPIRES_IN=1d
JWT_REFRESH_SECRET=super_secreto_refresh_para_desarrollo_caces_2026_seguro_minimo_32_caracteres
JWT_REFRESH_EXPIRES_IN=7d

# CORS
CORS_ORIGIN=http://localhost:4200

# Rate Limiting
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# Límites de Prueba Gratuita (Configurables)
TRIAL_MAX_PREGUNTAS=30
TRIAL_MAX_SIMULADORES=1
