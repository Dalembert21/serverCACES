datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

// ============================================================================
// 1. IDENTIDAD, SEGURIDAD Y CONTROL DE ACCESOS (RBAC)
// ============================================================================

enum RolNombre {
  SUPERADMIN
  TESORERIA
  ESTUDIANTE
}

model Usuario {
  id                   String   @id @default(uuid()) @map("USUARIO_ID")
  tipoIdentificacion   String   @default("CEDULA") @map("TIPO_IDENTIFICACION")
  cedula               String?  @unique @map("NUMERO_IDENTIFICACION")
  nombre               String?  @map("NOMBRES")
  apellido             String?  @map("APELLIDOS")
  nombreCompleto       String   @default("Estudiante") @map("NOMBRE_COMPLETO")
  correo               String   @unique @map("CORREO_ELECTRONICO")
  contrasenaHash       String?  @map("CONTRASENA_ENCRIPTADA")
  telefonoContacto     String?  @map("TELEFONO_CONTACTO")
  activo               Boolean  @default(true) @map("ESTADO_CUENTA_ACTIVA")
  correoVerificado     Boolean  @default(false) @map("CORREO_CONFIRMADO")
  rol                  String   @default("estudiante") @map("ROL")
  programaActivoId     String?  @map("PROGRAMA_ACTIVO_ID")
  googleId             String?  @unique @map("GOOGLE_ID")
  fotoUrl              String?  @map("FOTO_URL")
  proveedorAuth        String   @default("local") @map("PROVEEDOR_AUTH")
  creadoEn             DateTime @default(now()) @map("FECHA_REGISTRO")
  actualizadoEn        DateTime @updatedAt @map("FECHA_ACTUALIZACION")

  roles                     UsuarioRol[]
  sesiones                  SesionAutenticacion[]
  tokensRecuperacion        TokenRecuperacionContrasena[]
  casosClinicos             CasoClinico[]                 @relation("CasoClinicoAutor")
  preguntasCreadas          Pregunta[]                    @relation("PreguntaCreador")
  preguntasRevisadas        PreguntaVersion[]             @relation("PreguntaRevisor")
  intentos                  IntentoEvaluacion[]
  dominioCompetencias       DominioCognitivoCompetencia[]
  suscripciones             SuscripcionUsuario[]
  transacciones             TransaccionPago[]             @relation("TransaccionesPagador")
  transaccionesAprobadas    TransaccionPago[]             @relation("TransaccionesAdminAprobador")
  preferenciaAccesibilidad  PreferenciaAccesibilidad?
  perfilTrabajador          PerfilTrabajador?
  preguntasFavoritas        PreguntaFavorita[]
  notasPreguntas            NotaEstudiantePregunta[]
  auditoriasOperaciones     AuditoriaOperacionSistema[]
  auditoriasAccesos         AuditoriaAccesoSeguridad[]

  @@map("USUARIOS")
}

model PerfilTrabajador {
  id              String        @id @default(uuid()) @map("PERFIL_TRABAJADOR_ID")
  usuarioId       String        @unique @map("USUARIO_ID")
  cargo           String        @map("CARGO")
  departamentoId  String?       @map("DEPARTAMENTO_ID")
  departamento    String?       @map("DEPARTAMENTO")
  telefonoOficina String?       @map("TELEFONO_OFICINA")
  fechaIngreso    DateTime      @default(now()) @map("FECHA_INGRESO")
  activo          Boolean       @default(true) @map("ESTADO_ACTIVO")
  observaciones   String?       @db.Text @map("OBSERVACIONES")
  creadoEn        DateTime      @default(now()) @map("FECHA_CREACION")
  actualizadoEn   DateTime      @updatedAt @map("FECHA_ACTUALIZACION")

  usuario         Usuario       @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  departamentoRel Departamento? @relation(fields: [departamentoId], references: [id], onDelete: SetNull)

  @@index([cargo])
  @@index([departamento])
  @@index([departamentoId])
  @@map("PERFILES_TRABAJADORES")
}

model Departamento {
  id            String             @id @default(uuid()) @map("DEPARTAMENTO_ID")
  nombre        String             @unique @map("NOMBRE_DEPARTAMENTO")
  descripcion   String?            @map("DESCRIPCION_DEPARTAMENTO")
  activo        Boolean            @default(true) @map("ESTADO_ACTIVO")
  creadoEn      DateTime           @default(now()) @map("FECHA_CREACION")
  actualizadoEn DateTime           @updatedAt @map("FECHA_ACTUALIZACION")

  trabajadores  PerfilTrabajador[]

  @@map("DEPARTAMENTOS")
}

model Rol {
  id          String       @id @map("ROL_ID")
  nombre      RolNombre    @unique @map("NOMBRE_ROL")
  descripcion String?      @map("DESCRIPCION_ROL")
  activo      Boolean      @default(true) @map("ESTADO_ROL_ACTIVO")
  usuarios    UsuarioRol[]

  @@map("ROLES")
}

model UsuarioRol {
  usuarioId  String   @map("USUARIO_ID")
  rolId      String   @map("ROL_ID")
  asignadoEn DateTime @default(now()) @map("FECHA_ASIGNACION")

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  rol     Rol     @relation(fields: [rolId], references: [id], onDelete: Cascade)

  @@id([usuarioId, rolId])
  @@map("USUARIOS_ROLES")
}

model SesionAutenticacion {
  id                String   @id @default(uuid()) @map("SESION_ID")
  usuarioId         String   @map("USUARIO_ID")
  tokenHash         String   @unique @map("HASH_TOKEN_REFRESCO")
  direccionIp       String   @default("127.0.0.1") @map("DIRECCION_IP")
  dispositivoAcceso String   @default("DESCONOCIDO") @map("DISPOSITIVO_ACCESO")
  revocado          Boolean  @default(false) @map("ESTADO_REVOCADO")
  expiraEn          DateTime @map("FECHA_EXPIRACION")
  creadoEn          DateTime @default(now()) @map("FECHA_CREACION")

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId, revocado])
  @@map("SESIONES_AUTENTICACION")
}

model TokenRecuperacionContrasena {
  id         String   @id @default(uuid()) @map("TOKEN_RECUPERACION_ID")
  usuarioId  String   @map("USUARIO_ID")
  hashToken  String   @unique @map("HASH_TOKEN")
  utilizado  Boolean  @default(false) @map("ESTADO_UTILIZADO")
  expiraEn   DateTime @map("FECHA_EXPIRACION")
  creadoEn   DateTime @default(now()) @map("FECHA_CREACION")

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId, utilizado])
  @@map("TOKENS_RECUPERACION_CONTRASENA")
}

// ============================================================================
// 2. CATÁLOGO Y ESTRUCTURA ACADÉMICA OFICIAL CACES
// ============================================================================

model ProgramaAcademico {
  id                  String   @id @map("PROGRAMA_ACADEMICO_ID")
  codigoOficialCaces  String   @unique @map("CODIGO_OFICIAL_CACES")
  nombre              String   @map("NOMBRE_PROGRAMA")
  descripcion         String?  @map("DESCRIPCION_PROGRAMA")
  activo              Boolean  @default(true) @map("ESTADO_PROGRAMA_ACTIVO")
  creadoEn            DateTime @default(now()) @map("FECHA_CREACION")

  versionesTemarios         TemarioVersion[]
  configuracionesSimulador ConfiguracionSimulador[]

  @@map("PROGRAMAS_ACADEMICOS")
}

model TemarioVersion {
  id                   String    @id @default(uuid()) @map("VERSION_TEMARIO_ID")
  programaAcademicoId  String    @map("PROGRAMA_ACADEMICO_ID")
  codigoVersion        String    @map("CODIGO_VERSION")
  fechaInicioVigencia  DateTime  @default(now()) @map("FECHA_INICIO_VIGENCIA")
  fechaFinVigencia     DateTime? @map("FECHA_FIN_VIGENCIA")
  activo               Boolean   @default(true) @map("ESTADO_VIGENTE")
  creadoEn             DateTime  @default(now()) @map("FECHA_CREACION")

  programa ProgramaAcademico @relation(fields: [programaAcademicoId], references: [id], onDelete: Cascade)
  areas    AreaAcademica[]

  @@unique([programaAcademicoId, codigoVersion])
  @@map("VERSIONES_TEMARIOS")
}

model AreaAcademica {
  id               String   @id @default(uuid()) @map("AREA_ACADEMICA_ID")
  temarioVersionId String   @map("VERSION_TEMARIO_ID")
  nombre           String   @map("NOMBRE_AREA")
  descripcion      String?  @map("DESCRIPCION_AREA")
  pesoPorcentual   Float    @default(20.00) @map("PESO_PORCENTUAL_EXAMEN")

  temarioVersion       TemarioVersion          @relation(fields: [temarioVersionId], references: [id], onDelete: Cascade)
  subareasCompetencias SubareaCompetencia[]
  desglosesResultados  DesgloseResultadoArea[]

  @@map("AREAS_ACADEMICAS")
}

model SubareaCompetencia {
  id              String   @id @default(uuid()) @map("SUBAREA_COMPETENCIA_ID")
  areaAcademicaId String   @map("AREA_ACADEMICA_ID")
  codigoOficial   String   @map("CODIGO_OFICIAL")
  nombre          String   @map("NOMBRE_COMPETENCIA")
  descripcion     String?  @map("DESCRIPCION_COMPETENCIA")

  areaAcademica       AreaAcademica                 @relation(fields: [areaAcademicaId], references: [id], onDelete: Cascade)
  preguntas           Pregunta[]
  dominiosCognitivos  DominioCognitivoCompetencia[]

  @@unique([areaAcademicaId, codigoOficial])
  @@map("SUBAREAS_COMPETENCIAS")
}

// ============================================================================
// 3. BANCO DE PREGUNTAS Y CASOS CLÍNICOS (INMUTABLE Y VERSIONADO)
// ============================================================================

enum EstadoPregunta {
  BORRADOR
  EN_REVISION
  APROBADA
  PUBLICADA
  OBSERVADA
  RETIRADA
}

enum DificultadPregunta {
  BAJA
  MEDIA
  ALTA
}

enum TipoMultimedia {
  IMAGEN_RX
  IMAGEN_ECG
  TOMOGRAFIA
  FOTOGRAFIA_CLINICA
  OTRO
}

model CasoClinico {
  id               String   @id @default(uuid()) @map("CASO_CLINICO_ID")
  tituloCaso       String   @map("TITULO_CASO")
  narrativaClinica String   @db.Text @map("NARRATIVA_CLINICA")
  autorUsuarioId   String   @map("AUTOR_USUARIO_ID")
  creadoEn         DateTime @default(now()) @map("FECHA_CREACION")

  autor     Usuario    @relation("CasoClinicoAutor", fields: [autorUsuarioId], references: [id], onDelete: Restrict)
  preguntas Pregunta[]

  @@map("CASOS_CLINICOS")
}

model Pregunta {
  id                   String   @id @default(uuid()) @map("PREGUNTA_ID")
  subareaCompetenciaId String   @map("SUBAREA_COMPETENCIA_ID")
  casoClinicoId        String?  @map("CASO_CLINICO_ID")
  codigoPublico        String   @unique @map("CODIGO_IDENTIFICADOR_PUBLICO")
  creadorId            String   @map("AUTOR_DOCENTE_ID")
  creadoEn             DateTime @default(now()) @map("FECHA_CREACION")

  subarea     SubareaCompetencia @relation(fields: [subareaCompetenciaId], references: [id], onDelete: Restrict)
  casoClinico CasoClinico?       @relation(fields: [casoClinicoId], references: [id], onDelete: SetNull)
  creador     Usuario            @relation("PreguntaCreador", fields: [creadorId], references: [id], onDelete: Restrict)
  versiones   PreguntaVersion[]
  favoritos   PreguntaFavorita[]
  notasEstudiantes NotaEstudiantePregunta[]

  @@map("PREGUNTAS")
}

model PreguntaVersion {
  id                    String             @id @default(uuid()) @map("VERSION_PREGUNTA_ID")
  preguntaId            String             @map("PREGUNTA_ID")
  numeroVersion         Int                @default(1) @map("NUMERO_VERSION")
  enunciado             String             @db.Text @map("ENUNCIADO_PREGUNTA")
  explicacionPedagogica String             @db.Text @map("EXPLICACION_PEDAGOGICA")
  dificultad            DificultadPregunta @default(MEDIA) @map("GRADO_DIFICULTAD")
  estado                EstadoPregunta     @default(BORRADOR) @map("ESTADO_REVISION")
  revisorId             String?            @map("REVISOR_ACADEMICO_ID")
  fechaRevision         DateTime?          @map("FECHA_REVISION")
  creadoEn              DateTime           @default(now()) @map("FECHA_CREACION")

  pregunta          Pregunta                      @relation(fields: [preguntaId], references: [id], onDelete: Cascade)
  revisor           Usuario?                      @relation("PreguntaRevisor", fields: [revisorId], references: [id], onDelete: SetNull)
  opciones          PreguntaOpcion[]
  referencias       PreguntaReferencia[]
  activosMultimedia ActivoMultimedia[]
  respuestas        RespuestaIntentoEvaluacion[]

  @@unique([preguntaId, numeroVersion])
  @@index([estado, dificultad])
  @@map("VERSIONES_PREGUNTAS")
}

model PreguntaOpcion {
  id                String  @id @default(uuid()) @map("OPCION_RESPUESTA_ID")
  preguntaVersionId String  @map("VERSION_PREGUNTA_ID")
  letra             String  @map("LETRA_OPCION")
  texto             String  @db.Text @map("TEXTO_OPCION")
  esCorrecta        Boolean @default(false) @map("ES_OPCION_CORRECTA")
  justificacion     String? @db.Text @map("JUSTIFICACION_OPCION")

  preguntaVersion PreguntaVersion              @relation(fields: [preguntaVersionId], references: [id], onDelete: Cascade)
  respuestas      RespuestaIntentoEvaluacion[]

  @@unique([preguntaVersionId, letra])
  @@map("OPCIONES_RESPUESTA")
}

model ActivoMultimedia {
  id                  String         @id @default(uuid()) @map("MULTIMEDIA_PREGUNTA_ID")
  preguntaVersionId   String         @map("VERSION_PREGUNTA_ID")
  tipoActivo          TipoMultimedia @default(OTRO) @map("TIPO_RECURSO")
  urlAlmacenamiento   String         @map("URL_ALMACENAMIENTO")
  descripcionAccesible String        @db.Text @map("DESCRIPCION_ACCESIBLE_ALT")
  creadoEn            DateTime       @default(now()) @map("FECHA_SUBIDA")

  preguntaVersion PreguntaVersion @relation(fields: [preguntaVersionId], references: [id], onDelete: Cascade)

  @@map("MULTIMEDIA_PREGUNTAS")
}

model PreguntaReferencia {
  id                  String  @id @default(uuid()) @map("BIBLIOGRAFIA_REFERENCIA_ID")
  preguntaVersionId   String  @map("VERSION_PREGUNTA_ID")
  fuenteOficial       String  @map("FUENTE_OFICIAL")
  tituloPublicacion   String  @map("TITULO_PUBLICACION")
  anioPublicacion     Int     @map("ANIO_PUBLICACION")
  numeroPaginaCapitulo String? @map("NUMERO_PAGINA_CAPITULO")
  enlaceWebDocumento  String? @map("ENLACE_WEB_DOCUMENTO")

  preguntaVersion PreguntaVersion @relation(fields: [preguntaVersionId], references: [id], onDelete: Cascade)

  @@map("BIBLIOGRAFIA_REFERENCIAS")
}

// ============================================================================
// 4. MOTOR DE EVALUACIÓN Y SIMULADORES
// ============================================================================

enum TipoSimulador {
  SIMULACRO_OFICIAL
  DIAGNOSTICO
  PRACTICA_PERSONALIZADA
}

enum ModoRetroalimentacion {
  AL_FINALIZAR
  INMEDIATA
}

enum EstadoIntento {
  EN_PROGRESO
  FINALIZADO_USUARIO
  FINALIZADO_TIEMPO
  ABANDONADO
}

model ConfiguracionSimulador {
  id                   String        @id @default(uuid()) @map("CONFIGURACION_SIMULADOR_ID")
  programaAcademicoId  String        @map("PROGRAMA_ACADEMICO_ID")
  titulo               String        @map("TITULO_SIMULADOR")
  modalidad            TipoSimulador @default(SIMULACRO_OFICIAL) @map("MODALIDAD_SIMULADOR")
  duracionMinutos      Int           @map("DURACION_LIMITE_MINUTOS")
  totalPreguntas       Int           @map("CANTIDAD_TOTAL_PREGUNTAS")
  notaMinimaAprobacion Float         @default(70.00) @map("NOTA_MINIMA_APROBACION")
  activo               Boolean       @default(true) @map("ESTADO_CONFIGURACION_ACTIVA")

  programa ProgramaAcademico   @relation(fields: [programaAcademicoId], references: [id], onDelete: Cascade)
  intentos IntentoEvaluacion[]

  @@map("CONFIGURACIONES_SIMULADOR")
}

model IntentoEvaluacion {
  id                       String                 @id @default(uuid()) @map("INTENTO_EVALUACION_ID")
  usuarioId                String                 @map("USUARIO_ID")
  configuracionSimuladorId String?                @map("CONFIGURACION_SIMULADOR_ID")
  modalidad                TipoSimulador          @default(SIMULACRO_OFICIAL) @map("MODALIDAD_INTENTO")
  modoRetroalimentacion    ModoRetroalimentacion  @default(AL_FINALIZAR) @map("MODO_RETROALIMENTACION")
  filtrosPersonalizados    Json?                  @map("FILTROS_PERSONALIZADOS_JSON")
  estado                   EstadoIntento          @default(EN_PROGRESO) @map("ESTADO_INTENTO")
  fechaInicio              DateTime               @default(now()) @map("FECHA_HORA_INICIO")
  fechaFinalizacion        DateTime?              @map("FECHA_HORA_FINALIZACION")
  tiempoConsumidoSegundos  Int                    @default(0) @map("TIEMPO_CONSUMIDO_SEGUNDOS")
  creadoEn                 DateTime               @default(now()) @map("FECHA_CREACION")

  usuario                Usuario                      @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  configuracionSimulador ConfiguracionSimulador?      @relation(fields: [configuracionSimuladorId], references: [id], onDelete: SetNull)
  respuestas             RespuestaIntentoEvaluacion[]
  resultado              ResultadoIntentoConsolidado?

  @@index([usuarioId, estado])
  @@index([modalidad])
  @@map("INTENTOS_EVALUACIONES")
}

model RespuestaIntentoEvaluacion {
  id                    String   @id @default(uuid()) @map("RESPUESTA_INTENTO_ID")
  intentoId             String   @map("INTENTO_EVALUACION_ID")
  preguntaVersionId     String   @map("VERSION_PREGUNTA_ID")
  opcionSeleccionadaId  String?  @map("OPCION_RESPUESTA_SELECCIONADA_ID")
  esCorrecta            Boolean  @default(false) @map("ES_RESPUESTA_CORRECTA")
  marcadaParaRevision   Boolean  @default(false) @map("MARCADA_PARA_REVISION")
  tiempoRespuestaSegundos Int    @default(0) @map("TIEMPO_RESPUESTA_SEGUNDOS")
  fechaRespuesta        DateTime @default(now()) @map("FECHA_RESPUESTA")

  intento            IntentoEvaluacion @relation(fields: [intentoId], references: [id], onDelete: Cascade)
  preguntaVersion    PreguntaVersion   @relation(fields: [preguntaVersionId], references: [id], onDelete: Restrict)
  opcionSeleccionada PreguntaOpcion?   @relation(fields: [opcionSeleccionadaId], references: [id], onDelete: SetNull)

  @@unique([intentoId, preguntaVersionId])
  @@index([intentoId])
  @@map("RESPUESTAS_INTENTOS_EVALUACION")
}

model ResultadoIntentoConsolidado {
  id                    String   @id @default(uuid()) @map("RESULTADO_INTENTO_ID")
  intentoId             String   @unique @map("INTENTO_EVALUACION_ID")
  totalPreguntas        Int      @map("TOTAL_PREGUNTAS_EVALUADAS")
  totalAciertos         Int      @map("TOTAL_RESPUESTAS_CORRECTAS")
  totalErrores          Int      @map("TOTAL_RESPUESTAS_INCORRECTAS")
  totalOmitidas         Int      @map("TOTAL_PREGUNTAS_OMITIDAS")
  calificacionSobreCien Float    @map("CALIFICACION_SOBRE_CIEN")
  aprobado              Boolean  @map("RESULTADO_APROBATORIO")
  fechaCalculo          DateTime @default(now()) @map("FECHA_CALCULO")

  intento        IntentoEvaluacion       @relation(fields: [intentoId], references: [id], onDelete: Cascade)
  desglosesAreas DesgloseResultadoArea[]

  @@map("RESULTADOS_INTENTOS_CONSOLIDADOS")
}

model DesgloseResultadoArea {
  id                 String @id @default(uuid()) @map("DESGLOSE_RESULTADO_AREA_ID")
  resultadoIntentoId String @map("RESULTADO_INTENTO_ID")
  areaAcademicaId    String @map("AREA_ACADEMICA_ID")
  totalPreguntas     Int    @map("CANTIDAD_PREGUNTAS_AREA")
  aciertos           Int    @map("CANTIDAD_ACIERTOS_AREA")
  porcentajeObtenido Float  @map("PORCENTAJE_OBTENIDO")
  nivelCompetencia   String @map("NIVEL_COMPETENCIA_OBTENIDO")

  resultadoIntento ResultadoIntentoConsolidado @relation(fields: [resultadoIntentoId], references: [id], onDelete: Cascade)
  areaAcademica    AreaAcademica               @relation(fields: [areaAcademicaId], references: [id], onDelete: Restrict)

  @@unique([resultadoIntentoId, areaAcademicaId])
  @@map("DESGLOSE_RESULTADOS_AREAS")
}

// ============================================================================
// 5. ANALÍTICA DE DESEMPEÑO Y DOMINIO COGNITIVO
// ============================================================================

model DominioCognitivoCompetencia {
  id                   String   @id @default(uuid()) @map("DOMINIO_COGNITIVO_ID")
  usuarioId            String   @map("USUARIO_ID")
  subareaCompetenciaId String   @map("SUBAREA_COMPETENCIA_ID")
  totalRespondidas     Int      @default(0) @map("TOTAL_PREGUNTAS_RESPONDIDAS")
  totalAciertos        Int      @default(0) @map("TOTAL_ACIERTOS_ACUMULADOS")
  indiceDominio        Float    @default(0.00) @map("INDICE_DOMINIO_CALCULADO")
  actualizadoEn        DateTime @updatedAt @map("FECHA_ULTIMA_ACTUALIZACION")

  usuario            Usuario            @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  subareaCompetencia SubareaCompetencia @relation(fields: [subareaCompetenciaId], references: [id], onDelete: Cascade)

  @@unique([usuarioId, subareaCompetenciaId])
  @@map("DOMINIO_COGNITIVO_COMPETENCIAS")
}

// ============================================================================
// 6. MONETIZACIÓN, PLANES Y RECAUDACIÓN
// ============================================================================

enum EstadoSuscripcion {
  ACTIVA
  VENCIDA
  CANCELADA
  PENDIENTE_PAGO
}

enum EstadoPago {
  PENDIENTE_VERIFICACION
  APROBADA
  RECHAZADA
}

model PlanSuscripcion {
  id                           String   @id @map("PLAN_SUSCRIPCION_ID")
  nombre                       String   @map("NOMBRE_PLAN")
  descripcion                  String?  @map("DESCRIPCION_PLAN")
  precioDolares                Float    @default(0.00) @map("PRECIO_DOLARES")
  duracionDiasVigencia         Int      @map("DURACION_DIAS_VIGENCIA")
  limitePreguntasGratis        Int      @default(20) @map("LIMITE_PREGUNTAS_PRACTICA_GRATIS")
  accesoSimuladoresIlimitados  Boolean  @default(false) @map("ACCESO_SIMULADORES_ILIMITADOS")
  accesoAnaliticaAvanzada      Boolean  @default(false) @map("ACCESO_ANALITICA_AVANZADA")
  activo                       Boolean  @default(true) @map("ESTADO_PLAN_ACTIVO")

  suscripciones SuscripcionUsuario[]

  @@map("PLANES_SUSCRIPCION")
}

model SuscripcionUsuario {
  id                          String            @id @default(uuid()) @map("SUSCRIPCION_USUARIO_ID")
  usuarioId                   String            @map("USUARIO_ID")
  planId                      String            @map("PLAN_SUSCRIPCION_ID")
  estado                      EstadoSuscripcion @default(PENDIENTE_PAGO) @map("ESTADO_SUSCRIPCION")
  iniciaEn                    DateTime          @default(now()) @map("FECHA_INICIO_VIGENCIA")
  expiraEn                    DateTime          @map("FECHA_FIN_VIGENCIA")
  preguntasGratisConsumidas   Int               @default(0) @map("PREGUNTAS_GRATIS_CONSUMIDAS")
  simuladoresGratisConsumidos Int               @default(0) @map("SIMULADORES_GRATIS_CONSUMIDOS")
  creadoEn                    DateTime          @default(now()) @map("FECHA_CREACION")

  usuario       Usuario           @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  plan          PlanSuscripcion   @relation(fields: [planId], references: [id], onDelete: Restrict)
  transacciones TransaccionPago[]

  @@index([usuarioId, estado])
  @@map("SUSCRIPCIONES_USUARIOS")
}

model TransaccionPago {
  id                           String     @id @default(uuid()) @map("TRANSACCION_PAGO_ID")
  suscripcionUsuarioId         String     @map("SUSCRIPCION_USUARIO_ID")
  usuarioPagadorId             String     @map("USUARIO_PAGADOR_ID")
  entidadBancariaOrigen        String     @map("ENTIDAD_BANCARIA_ORIGEN")
  numeroComprobanteReferencia  String     @unique @map("NUMERO_COMPROBANTE_REFERENCIA")
  montoDolares                 Float      @map("MONTO_TRANSACCION_DOLARES")
  urlFotoComprobante           String?    @map("URL_FOTO_COMPROBANTE")
  estado                       EstadoPago @default(PENDIENTE_VERIFICACION) @map("ESTADO_TRANSACCION")
  administradorAprobadorId     String?    @map("ADMINISTRADOR_APROBADOR_ID")
  motivoObservacionAdmin       String?    @db.Text @map("MOTIVO_OBSERVACION_ADMIN")
  fechaPagoDeclarada           DateTime   @map("FECHA_PAGO_DECLARADA")
  creadoEn                     DateTime   @default(now()) @map("FECHA_CREACION")

  suscripcion            SuscripcionUsuario @relation(fields: [suscripcionUsuarioId], references: [id], onDelete: Cascade)
  usuarioPagador         Usuario            @relation("TransaccionesPagador", fields: [usuarioPagadorId], references: [id], onDelete: Cascade)
  administradorAprobador Usuario?           @relation("TransaccionesAdminAprobador", fields: [administradorAprobadorId], references: [id], onDelete: SetNull)

  @@index([estado])
  @@map("TRANSACCIONES_PAGOS")
}

// ============================================================================
// 7. AUDITORÍA INTEGRAL Y TRAZABILIDAD EMPRESARIAL
// ============================================================================

model AuditoriaOperacionSistema {
  id                             BigInt   @id @default(autoincrement()) @map("AUDITORIA_OPERACION_ID")
  usuarioOperadorId              String?  @map("USUARIO_OPERADOR_ID")
  tipoAccion                     String   @map("TIPO_ACCION")
  nombreTablaAfectada            String   @map("NOMBRE_TABLA_AFECTADA")
  identificadorRegistroAfectado  String   @map("IDENTIFICADOR_REGISTRO_AFECTADO")
  datosAnterioresJson            Json?    @map("DATOS_ANTERIORES_JSON")
  datosNuevosJson                Json?    @map("DATOS_NUEVOS_JSON")
  motivoJustificacion            String?  @db.Text @map("MOTIVO_JUSTIFICACION")
  direccionIpCliente             String   @map("DIRECCION_IP_CLIENTE")
  agenteDispositivoUserAgent     String?  @db.Text @map("AGENTE_DISPOSITIVO_USER_AGENT")
  fechaHoraRegistro              DateTime @default(now()) @map("FECHA_HORA_REGISTRO")

  usuarioOperador Usuario? @relation(fields: [usuarioOperadorId], references: [id], onDelete: SetNull)

  @@index([nombreTablaAfectada, identificadorRegistroAfectado])
  @@index([fechaHoraRegistro])
  @@map("AUDITORIA_OPERACIONES_SISTEMA")
}

model AuditoriaAccesoSeguridad {
  id                  BigInt   @id @default(autoincrement()) @map("AUDITORIA_ACCESO_ID")
  usuarioId           String?  @map("USUARIO_ID")
  correoIngresado     String   @map("CORREO_INGRESADO")
  eventoSeguridad     String   @map("EVENTO_SEGURIDAD")
  accesoPermitido     Boolean  @map("ACCESO_PERMITIDO")
  detalleObservacion  String?  @db.Text @map("DETALLE_OBSERVACION")
  direccionIpOrigen   String   @map("DIRECCION_IP_ORIGEN")
  agenteDispositivo   String?  @db.Text @map("AGENTE_DISPOSITIVO")
  fechaHoraEvento     DateTime @default(now()) @map("FECHA_HORA_EVENTO")

  usuario Usuario? @relation(fields: [usuarioId], references: [id], onDelete: SetNull)

  @@index([usuarioId])
  @@index([correoIngresado])
  @@index([fechaHoraEvento])
  @@map("AUDITORIA_ACCESOS_SEGURIDAD")
}

// ============================================================================
// 8. ACCESIBILIDAD UNIVERSAL E INCLUSIÓN
// ============================================================================

enum TamanoTexto {
  PEQUENO
  NORMAL
  GRANDE
  EXTRA_GRANDE
}

enum EspaciadoTexto {
  NORMAL
  AMPLIO
  EXTRA_AMPLIO
}

enum PaletaColor {
  ESTANDAR
  PROTANOPIA
  DEUTERANOPIA
  TRITANOPIA
  MONOCROMATICO
}

model PreferenciaAccesibilidad {
  id                  String         @id @default(uuid()) @map("PREFERENCIA_ACCESIBILIDAD_ID")
  usuarioId           String         @unique @map("USUARIO_ID")
  tamanoTexto         TamanoTexto    @default(NORMAL) @map("TAMANO_TEXTO")
  altoContraste       Boolean        @default(false) @map("ALTO_CONTRASTE")
  fuenteDislexia      Boolean        @default(false) @map("FUENTE_DISLEXIA")
  espaciadoTexto      EspaciadoTexto @default(NORMAL) @map("ESPACIADO_TEXTO")
  movimientoReducido  Boolean        @default(false) @map("MOVIMIENTO_REDUCIDO")
  subtitulosActivados Boolean        @default(false) @map("SUBTITULOS_ACTIVADOS")
  cursorGrande        Boolean        @default(false) @map("CURSOR_GRANDE")
  lecturaGuiada       Boolean        @default(false) @map("LECTURA_GUIADA")
  paletaColor         PaletaColor    @default(ESTANDAR) @map("PALETA_COLOR")
  sintesisVozLectura  Boolean        @default(false) @map("SINTESIS_VOZ_LECTURA")
  creadoEn            DateTime       @default(now()) @map("FECHA_CREACION")
  actualizadoEn       DateTime       @updatedAt @map("FECHA_ACTUALIZACION")

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@map("PREFERENCIAS_ACCESIBILIDAD")
}

// ============================================================================
// 9. BANCO PERSONAL, FAVORITOS Y NOTAS DEL ESTUDIANTE
// ============================================================================

model PreguntaFavorita {
  id         String   @id @default(uuid()) @map("PREGUNTA_FAVORITA_ID")
  usuarioId  String   @map("USUARIO_ID")
  preguntaId String   @map("PREGUNTA_ID")
  carpeta    String   @default("GENERAL") @map("CARPETA_CLASIFICACION")
  creadoEn   DateTime @default(now()) @map("FECHA_GUARDADO")

  usuario  Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  pregunta Pregunta @relation(fields: [preguntaId], references: [id], onDelete: Cascade)

  @@unique([usuarioId, preguntaId])
  @@index([usuarioId])
  @@map("PREGUNTAS_FAVORITAS")
}

model NotaEstudiantePregunta {
  id            String   @id @default(uuid()) @map("NOTA_ESTUDIANTE_ID")
  usuarioId     String   @map("USUARIO_ID")
  preguntaId    String   @map("PREGUNTA_ID")
  contenidoNota String   @db.Text @map("CONTENIDO_NOTA")
  creadoEn      DateTime @default(now()) @map("FECHA_CREACION")
  actualizadoEn DateTime @updatedAt @map("FECHA_ACTUALIZACION")

  usuario  Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  pregunta Pregunta @relation(fields: [preguntaId], references: [id], onDelete: Cascade)

  @@unique([usuarioId, preguntaId])
  @@index([usuarioId])
  @@map("NOTAS_ESTUDIANTE_PREGUNTAS")
}
